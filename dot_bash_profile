# Fix: non-WT terminals (Alacritty from Start Menu, PowerToys Run) inherit only Machine PATH.
# So append the User PATH from the registry (code, npm, winget). cygpath converts it, because a
# C:\ entry splits at the colon. Must run before .bashrc (fzf/zoxide). Costs about 50 ms per shell.
if [[ -z "$WT_SESSION" ]]; then
    user_path=$(reg.exe query 'HKCU\Environment' //v Path 2>/dev/null | sed -n 's/^ *Path *REG_[A-Z_]* *//p' | tr -d '\r')
    [[ -n "$user_path" ]] && export PATH="$PATH:$(cygpath -u -p "$user_path")"
fi

if [ -f ~/.bashrc ]; then
    source ~/.bashrc
fi

export dev="$HOME/dev"

# Added by get-aspire-cli.sh
export PATH="$HOME/.aspire/bin:$PATH"

# Run one-off .NET tools (dnx.cmd is not executable in Git Bash)
alias dnx='dotnet tool exec'
# Added by @codemieai/code
export PATH="C:\Users\nikiforovall\AppData\Roaming\npm\bin:$PATH"
